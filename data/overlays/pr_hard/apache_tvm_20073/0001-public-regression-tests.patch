+def _tirx_source(func):
+    """Leave a function intact while marking its source as TIRx."""
+    return func
+
+
+_tirx_source.dispatch_token = "tirx"
 
 
 def matmul(a: T.handle, b: T.handle, c: T.handle) -> None:
