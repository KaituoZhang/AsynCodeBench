│   ├── repos/commit0/          # local materialized public repos
│   └── overlays/commit0/       # checksum-pinned bootstrap overlays
├── docs/
│   ├── audits/                 # candidate audit notes
│   └── protocols/              # construction and metric-label guides
├── manifests/
│   ├── candidates/             # screening outputs
│   ├── pilot/v0.3/
│   │   ├── tasks/
│   │   ├── scenarios/
│   │   ├── quality/
│   │   └── metrics/
│   └── annotations/commit0_v0.3/
