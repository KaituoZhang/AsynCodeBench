{
  "$defs": {
    "ParallelizabilityLabel": {
      "enum": [
        "parallelizable",
        "partially_parallelizable",
        "effectively_serial"
      ],
      "title": "ParallelizabilityLabel",
      "type": "string"
    }
  },
  "additionalProperties": false,
  "properties": {
    "adjudication_result": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Adjudication Result"
    },
    "annotator_decisions": {
      "additionalProperties": {
        "$ref": "#/$defs/ParallelizabilityLabel"
      },
      "title": "Annotator Decisions",
      "type": "object"
    },
    "candidate_parallel_subproblems": {
      "items": {
        "type": "string"
      },
      "title": "Candidate Parallel Subproblems",
      "type": "array"
    },
    "cross_module_constraints": {
      "items": {
        "type": "string"
      },
      "title": "Cross Module Constraints",
      "type": "array"
    },
    "dependency_separability": {
      "title": "Dependency Separability",
      "type": "string"
    },
    "exclusion_reason": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Exclusion Reason"
    },
    "expected_overlap_surface": {
      "items": {
        "type": "string"
      },
      "title": "Expected Overlap Surface",
      "type": "array"
    },
    "expected_shared_resource_contention": {
      "title": "Expected Shared Resource Contention",
      "type": "string"
    },
    "gold_informed_secondary_label": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Gold Informed Secondary Label"
    },
    "issue_summary": {
      "title": "Issue Summary",
      "type": "string"
    },
    "measured_test_and_build_duration": {
      "minimum": 0.0,
      "title": "Measured Test And Build Duration",
      "type": "number"
    },
    "measurement_command": {
      "items": {
        "type": "string"
      },
      "title": "Measurement Command",
      "type": "array"
    },
    "measurement_environment": {
      "additionalProperties": {
        "type": "string"
      },
      "title": "Measurement Environment",
      "type": "object"
    },
    "measurement_return_code": {
      "anyOf": [
        {
          "type": "integer"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Measurement Return Code"
    },
    "measurement_timed_out": {
      "title": "Measurement Timed Out",
      "type": "boolean"
    },
    "parallelizability_label": {
      "$ref": "#/$defs/ParallelizabilityLabel"
    },
    "public_evidence_sources": {
      "items": {
        "type": "string"
      },
      "title": "Public Evidence Sources",
      "type": "array"
    },
    "public_module_count": {
      "minimum": 0,
      "title": "Public Module Count",
      "type": "integer"
    },
    "publicly_implicated_modules": {
      "items": {
        "type": "string"
      },
      "title": "Publicly Implicated Modules",
      "type": "array"
    },
    "schema_version": {
      "const": "asynccodebench-v0.2",
      "default": "asynccodebench-v0.2",
      "title": "Schema Version",
      "type": "string"
    },
    "static_dependency_edges": {
      "items": {
        "maxItems": 2,
        "minItems": 2,
        "prefixItems": [
          {
            "type": "string"
          },
          {
            "type": "string"
          }
        ],
        "type": "array"
      },
      "title": "Static Dependency Edges",
      "type": "array"
    },
    "task_id": {
      "minLength": 1,
      "title": "Task Id",
      "type": "string"
    },
    "task_source": {
      "minLength": 1,
      "title": "Task Source",
      "type": "string"
    },
    "test_target_independence": {
      "title": "Test Target Independence",
      "type": "string"
    },
    "test_targets": {
      "items": {
        "type": "string"
      },
      "title": "Test Targets",
      "type": "array"
    },
    "upstream_version": {
      "minLength": 1,
      "title": "Upstream Version",
      "type": "string"
    }
  },
  "required": [
    "task_id",
    "task_source",
    "upstream_version",
    "issue_summary",
    "publicly_implicated_modules",
    "public_module_count",
    "dependency_separability",
    "static_dependency_edges",
    "test_targets",
    "test_target_independence",
    "measured_test_and_build_duration",
    "measurement_command",
    "measurement_timed_out",
    "measurement_environment",
    "candidate_parallel_subproblems",
    "cross_module_constraints",
    "expected_overlap_surface",
    "expected_shared_resource_contention",
    "public_evidence_sources",
    "parallelizability_label",
    "annotator_decisions"
  ],
  "title": "QualificationCard",
  "type": "object"
}
