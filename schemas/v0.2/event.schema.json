{
  "$defs": {
    "EventType": {
      "enum": [
        "AgentActivated",
        "LLMJobStarted",
        "LLMJobCompleted",
        "ToolJobStarted",
        "ToolJobCompleted",
        "PatchProduced",
        "PatchTransferred",
        "MessageSent",
        "MessageDelivered",
        "MessageRead",
        "WorkspaceUpdated",
        "IntegratedBranchUpdated",
        "IntegrationAttempted",
        "IntegrationCompleted",
        "ReviewStarted",
        "ReviewCompleted",
        "ArtifactInvalidated",
        "ResourceAcquired",
        "ResourceReleased",
        "JobCancelled",
        "Timeout",
        "SubmissionCreated",
        "EpisodeTerminated"
      ],
      "title": "EventType",
      "type": "string"
    }
  },
  "additionalProperties": false,
  "properties": {
    "actor": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Actor"
    },
    "causal_parent_ids": {
      "default": [],
      "items": {
        "type": "string"
      },
      "title": "Causal Parent Ids",
      "type": "array"
    },
    "event_id": {
      "minLength": 1,
      "title": "Event Id",
      "type": "string"
    },
    "event_type": {
      "$ref": "#/$defs/EventType"
    },
    "logical_time": {
      "minimum": 0.0,
      "title": "Logical Time",
      "type": "number"
    },
    "payload_reference": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Payload Reference"
    },
    "schema_version": {
      "const": "asynccodebench-v0.2",
      "default": "asynccodebench-v0.2",
      "title": "Schema Version",
      "type": "string"
    },
    "visible_to": {
      "default": [],
      "items": {
        "type": "string"
      },
      "title": "Visible To",
      "type": "array"
    },
    "wall_clock_time_if_live": {
      "anyOf": [
        {
          "minimum": 0.0,
          "type": "number"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Wall Clock Time If Live"
    }
  },
  "required": [
    "event_id",
    "logical_time",
    "event_type"
  ],
  "title": "EventRecord",
  "type": "object"
}
