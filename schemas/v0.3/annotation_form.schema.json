{
  "$defs": {
    "ParallelizabilityLabel": {
      "enum": [
        "parallelizable",
        "partially_parallelizable",
        "effectively_serial"
      ],
      "title": "ParallelizabilityLabel",
      "type": "string"
    }
  },
  "additionalProperties": false,
  "description": "Answer-free form assigned to one genuinely independent human.",
  "properties": {
    "allowed_labels": {
      "items": {
