      },
      "title": "Allowed Labels",
      "type": "array"
    },
    "annotator_id": {
      "minLength": 1,
      "title": "Annotator Id",
      "type": "string"
    },
    "candidate_evidence_file": {
      "minLength": 1,
      "title": "Candidate Evidence File",
      "type": "string"
    },
    "exclusion_reason": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Exclusion Reason"
    },
    "include": {
      "anyOf": [
        {
          "type": "boolean"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Include"
    },
    "independence_instructions": {
      "items": {
        "type": "string"
      },
      "title": "Independence Instructions",
      "type": "array"
    },
    "parallelizability_label": {
      "anyOf": [
        {
          "$ref": "#/$defs/ParallelizabilityLabel"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "rationale": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Rationale"
    },
    "schema_version": {
      "const": "0.3",
      "default": "0.3",
      "title": "Schema Version",
      "type": "string"
    },
    "source_task_id": {
      "anyOf": [
        {
          "minLength": 1,
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Source Task Id"
    },
    "task_id": {
      "minLength": 1,
      "title": "Task Id",
      "type": "string"
    },
    "task_record_file": {
      "minLength": 1,
      "title": "Task Record File",
      "type": "string"
    }
  },
  "required": [
    "task_id",
    "annotator_id",
    "candidate_evidence_file",
    "task_record_file",
    "allowed_labels",
    "independence_instructions"
